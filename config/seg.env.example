# Образец формата config/seg.env (режим SEG). Рабочий файл создаёт
# generate-server-env.ps1 -Mode SEG; копировать этот образец как есть нельзя:
# секреты пусты, параметры AmneziaWG - нули.
# VPS1 = seg-exit (инициирует backhaul), VPS2 = seg-gateway (принимает backhaul).

# REALITY (gateway)
SEG_REALITY_PRIVATE_KEY=
SEG_REALITY_PUBLIC_KEY=
SEG_REALITY_SHORT_ID=
SEG_REALITY_SERVER_NAME=www.microsoft.com
SEG_REALITY_DEST=www.microsoft.com:443
SEG_REALITY_FLOW=xtls-rprx-vision
SEG_REALITY_FINGERPRINT=chrome

# Backhaul AmneziaWG: отдельные ключи, PSK, сеть и порт, не связанные с режимом VPN
SEG_BACKHAUL_PRIVATE_KEY_VPS1=
SEG_BACKHAUL_PUBLIC_KEY_VPS1=
SEG_BACKHAUL_PRIVATE_KEY_VPS2=
SEG_BACKHAUL_PUBLIC_KEY_VPS2=
SEG_BACKHAUL_PSK=
SEG_BACKHAUL_NETWORK=10.77.0.0/30
SEG_BACKHAUL_VPS1=10.77.0.2
SEG_BACKHAUL_VPS2=10.77.0.1
SEG_BACKHAUL_PORT=42100
SEG_BACKHAUL_INTERFACE=awg-backhaul
SEG_BACKHAUL_MTU=800
SEG_BACKHAUL_RANDOM_TRAILERS=on

SEG_BACKHAUL_JC=0
SEG_BACKHAUL_JMIN=0
SEG_BACKHAUL_JMAX=0

SEG_BACKHAUL_S1=0
SEG_BACKHAUL_S2=0
SEG_BACKHAUL_S3=0
SEG_BACKHAUL_S4=0

SEG_BACKHAUL_H1=0
SEG_BACKHAUL_H2=0
SEG_BACKHAUL_H3=0
SEG_BACKHAUL_H4=0

# Метки nftables: selected-трафик (fail-closed) и direct outbound (счётчик UNMATCHED_DIRECT)
SEG_MARK=0x5e90
SEG_UNMATCHED_MARK=0x5e91

# Трафик вне seg-list на VPS2: direct | block
SEG_UNMATCHED_POLICY=direct
