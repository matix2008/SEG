server:
    interface: {{SEG_BACKHAUL_VPS1}}
    port: 53
    ip-freebind: yes
    access-control: 0.0.0.0/0 refuse
    access-control: {{SEG_BACKHAUL_VPS2}}/32 allow
    do-ip6: no
    do-not-query-localhost: yes
    hide-identity: yes
    hide-version: yes
    msg-cache-size: 8m
    rrset-cache-size: 16m
    num-threads: 1
